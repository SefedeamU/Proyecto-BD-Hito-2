# ===== Demo del experimento de índices — perfil LOCAL =====
# Las 8 bases del experimento (_idx / _noidx) viven en tu PostgreSQL LOCAL,
# NO en el servidor remoto (el rol bd_guest no puede crearlas allí). Por eso la
# API debe apuntar a tu Postgres local. Copia este archivo a .env y completa
# PGPASSWORD. NUNCA subas el .env real (está en .gitignore).
PGHOST=localhost
PGPORT=5432
PGUSER=ghost            # tu rol superusuario local (el que creó las 8 bases)
PGPASSWORD=changeme
PGDATABASE=bd_literaria_10k_idx
PGSSLMODE=disable
API_PORT=7000

# Allowlist de las 8 bases (idx = con índices del informe, noidx = sin índices).
# El frontend arma el nombre completo según el volumen elegido y el toggle.
DATABASES=bd_literaria_1k_idx,bd_literaria_1k_noidx,bd_literaria_10k_idx,bd_literaria_10k_noidx,bd_literaria_100k_idx,bd_literaria_100k_noidx,bd_literaria_1m_idx,bd_literaria_1m_noidx
