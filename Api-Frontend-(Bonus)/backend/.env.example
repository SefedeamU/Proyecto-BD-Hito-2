# Conexión a la base remota (mismos datos que faker/.env). Copia a .env y
# completa PGPASSWORD. NUNCA subas el .env real (está en .gitignore).
# La demo es 100% online: la API vive en la EC2 y consulta las 8 bases del
# experimento (idx/noidx) que también están en la EC2, con el rol bd_guest.
PGHOST=18.214.247.229
PGPORT=5432
PGUSER=bd_guest
PGPASSWORD=changeme
PGDATABASE=bd_literaria_10k_idx
PGSSLMODE=prefer
API_PORT=7000

# Allowlist de las 8 bases (idx = con índices del informe, noidx = sin índices).
# El frontend arma el nombre completo según el volumen elegido y el toggle.
DATABASES=bd_literaria_1k_idx,bd_literaria_1k_noidx,bd_literaria_10k_idx,bd_literaria_10k_noidx,bd_literaria_100k_idx,bd_literaria_100k_noidx,bd_literaria_1m_idx,bd_literaria_1m_noidx
