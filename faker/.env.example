# =====================================================================
# Configuración del proyecto faker — plataforma literaria (Hito 2)
# Copia este archivo a  .env  y ajusta los valores.
# =====================================================================

# --- Conexión común a PostgreSQL (las 4 bases comparten host/credenciales)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres

# --- Nombres de las 4 bases (una por escenario de volumen de la rúbrica)
DB_1K=bd_literaria_1k
DB_10K=bd_literaria_10k
DB_100K=bd_literaria_100k
DB_1M=bd_literaria_1m

# --- Comportamiento de la carga
# APPLY_SCHEMA=true  -> crea la base (si falta) y aplica sql/00..03 antes de poblar.
#                       (Los índices 04 NO se aplican aquí: van en la fase de experimento.)
APPLY_SCHEMA=true

# DISABLE_TRIGGERS=true -> desactiva triggers durante el COPY para acelerar
#                          la carga masiva (los datos se generan ya válidos).
#                          Requiere ser dueño de las tablas. Ponlo en false si
#                          no tienes ese privilegio (la carga será más lenta).
DISABLE_TRIGGERS=true

# Semilla para reproducibilidad de los datos sintéticos.
SEED=42
